# AI provider configuration
# Supported providers: gemini, openrouter, openai
AI_PROVIDER=gemini

# Use AI_API_KEY as the common key, or provider-specific keys below.
AI_API_KEY=

# Gemini setup
# Get your API key from: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-2.0-flash
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=1500

# OpenRouter setup
OPENROUTER_API_KEY=

# OpenAI setup
OPENAI_API_KEY=

# Choose a model that matches your provider.
# Gemini example: gemini-2.5-flash
# OpenRouter example: openai/gpt-4o-mini
# OpenAI example: gpt-4o-mini
# Local Ollama example: qwen2.5vl:7b
AI_MODEL=gemini-2.5-flash

# Optional for OpenAI-compatible local/hosted endpoints.
# Example Ollama: http://localhost:11434/v1
AI_BASE_URL=

# Optional: reuse live results for near-identical frames for 45s
AI_CACHE_TTL_MS=45000

# Server Port
PORT=3000
